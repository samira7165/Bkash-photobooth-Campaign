generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Gender {
  male
  female
}

enum SessionStatus {
  created
  job_selected
  image_captured
  queued
  processing
  generated
  sms_sent
  failed
}

model Session {
  id                    String        @id @default(uuid())
  name                  String        @db.VarChar(100)
  phone                 String        @db.VarChar(20)
  email                 String?       @db.VarChar(150)
  college               String?       @db.VarChar(200)
  gender                Gender
  selectedJob           String?       @db.VarChar(100)
  customJob             String?       @db.VarChar(200)
  originalImagePath     String?       @db.VarChar(500)
  generatedImagePath    String?       @db.VarChar(500)
  // Pre-rendered (framed/branded) copies, cached to disk once so the
  // download portal never has to redo Sharp compositing on every view.
  renderedOriginalPath  String?       @db.VarChar(500)
  renderedGeneratedPath String?       @db.VarChar(500)
  status                SessionStatus @default(created)
  smsSent               Boolean       @default(false)
  smsShortUrl           String?       @db.VarChar(500)
  smsAttempts           Int           @default(0)
  smsLastAttemptAt      DateTime?
  queuePosition         Int?
  downloadCount         Int           @default(0)
  comicDownloadCount    Int           @default(0)
  errorMessage          String?       @db.Text
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([phone])
  @@index([status])
  @@map("sessions")
}

model JobBaseImage {
  id            String   @id @default(uuid())
  job           String   @db.VarChar(100)
  gender        String   @db.VarChar(10)
  imageUrl      String   @db.VarChar(500)
  imagePath     String?  @db.VarChar(500)
  isActive      Boolean  @default(true)
  autoGenerated Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([job, gender])
  @@map("job_base_images")
}

model FaceSwapSettings {
  id        String   @id @db.VarChar(20)
  apiUrl    String?  @db.VarChar(500)
  apiKey    String?  @db.Text
  model     String?  @db.VarChar(100)
  updatedAt DateTime @updatedAt

  @@map("face_swap_settings")
}

model PromptTemplate {
  id                  String   @id @default(uuid())
  name                String   @db.VarChar(100)
  isDefault           Boolean  @default(false)
  // Used instead of isDefault for custom "Other" careers (routed to OpenAI,
  // which has no pre-made frame artwork to composite afterward) — separate
  // from the 12 known careers' default template (Gemini, framed with PNG
  // overlays). Falls back to isDefault, then a hardcoded prompt, if unset.
  isDefaultForCustom  Boolean  @default(false)
  promptText          String   @db.Text
  negativePrompt      String?  @db.Text
  requestBodyTemplate String?  @db.Text
  notes               String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("prompt_templates")
}

model AiProvider {
  id         String    @id @default(uuid())
  name       String    @db.VarChar(100)
  apiUrl     String    @db.VarChar(500)
  apiKey     String    @db.Text
  model      String?   @db.VarChar(100)
  priority   Int       @default(0)
  isActive   Boolean   @default(true)
  failCount  Int       @default(0)
  lastFailAt DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("ai_providers")
}

model SmsProvider {
  id         String    @id @default(uuid())
  name       String    @db.VarChar(100)
  apiUrl     String    @db.VarChar(500)
  apiKey     String    @db.Text
  senderId   String?   @db.VarChar(50)
  priority   Int       @default(0)
  isActive   Boolean   @default(true)
  failCount  Int       @default(0)
  lastFailAt DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("sms_providers")
}

model AdminUser {
  id           String    @id @default(uuid())
  username     String    @unique @db.VarChar(50)
  passwordHash String    @db.VarChar(255)
  displayName  String    @db.VarChar(100)
  role         String    @default("admin") @db.VarChar(20)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admin_users")
}

model AdminSession {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@map("admin_sessions")
}

// ═══════════════════════════════════════════════════════════
// Mobile QR experience + download portal
// Separate from Session/the physical booth flow by design —
// Event/Participant/Image/Otp back the two new public journeys.
// ═══════════════════════════════════════════════════════════

enum ParticipantGender {
  male
  female
}

enum ImageProcessingStatus {
  queued
  processing
  generated
  sms_sent
  failed
}

model Event {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(150)
  pdfPath   String?  @db.VarChar(500)
  pdfName   String?  @db.VarChar(255)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants Participant[]

  @@map("events")
}

model Participant {
  id        String            @id @default(uuid())
  name      String            @db.VarChar(100)
  // Global — one phone number can only ever have one Participant record,
  // across every event, not just the current one.
  phone     String            @unique @db.VarChar(20)
  email     String?           @db.VarChar(150)
  college   String?           @db.VarChar(200)
  gender    ParticipantGender
  career    String            @db.VarChar(100)
  eventId   String
  createdAt DateTime          @default(now())

  event  Event   @relation(fields: [eventId], references: [id])
  images Image[]

  @@index([eventId])
  @@map("participants")
}

model Image {
  id                   String                @id @default(uuid())
  participantId        String
  // Client-generated key sent with the upload so a retried request (e.g. the
  // first response was lost to a network drop) reattaches to the same image
  // instead of creating a second row — which would mean two generations and
  // two notification SMS for one photo.
  clientRequestId      String?               @unique @db.VarChar(64)
  originalImageUrl     String?               @db.VarChar(500)
  aiImageUrl           String?               @db.VarChar(500)
  // Pre-rendered (framed/branded) copies, cached to disk once so the
  // download portal never has to redo Sharp compositing on every view.
  renderedOriginalPath String?               @db.VarChar(500)
  renderedAiPath       String?               @db.VarChar(500)
  processingStatus     ImageProcessingStatus @default(queued)
  downloadCount        Int                   @default(0)
  comicDownloadCount   Int                   @default(0)
  errorMessage         String?               @db.Text
  smsSent              Boolean               @default(false)
  smsAttempts          Int                   @default(0)
  smsLastAttemptAt     DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  participant Participant @relation(fields: [participantId], references: [id])

  @@index([participantId])
  @@index([processingStatus])
  @@map("images")
}

model Otp {
  id        String   @id @default(uuid())
  phone     String   @db.VarChar(20)
  otpCode   String   @db.VarChar(6)
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
  @@map("otps")
}

/// One row per landing-page hit carrying a `?qr=` parameter, so printed codes
/// can be compared against each other. Stored per-scan rather than as a
/// counter column so scans stay attributable to a code and a point in time
/// (and so two concurrent scans can't clobber each other's increment).
model QrScan {
  id        String   @id @default(uuid())
  /// The raw `?qr=` value, e.g. "f1". Free-form so new codes can be printed
  /// and tracked without a schema change or a deploy.
  code      String   @db.VarChar(50)
  createdAt DateTime @default(now())

  @@index([code])
  @@index([createdAt])
  @@map("qr_scans")
}
