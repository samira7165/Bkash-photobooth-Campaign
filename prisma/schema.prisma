generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Gender {
  male
  female
}

enum SessionStatus {
  created
  job_selected
  image_captured
  queued
  processing
  generated
  sms_sent
  failed
}

model Session {
  id                 String        @id @default(uuid())
  name               String        @db.VarChar(100)
  phone              String        @db.VarChar(20)
  email              String?       @db.VarChar(150)
  gender             Gender
  selectedJob        String?       @db.VarChar(100)
  customJob          String?       @db.VarChar(200)
  originalImagePath  String?       @db.VarChar(500)
  generatedImagePath String?       @db.VarChar(500)
  status             SessionStatus @default(created)
  smsSent            Boolean       @default(false)
  smsShortUrl        String?       @db.VarChar(500)
  queuePosition      Int?
  errorMessage       String?       @db.Text
  campaignId         String?
  campaign           Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([phone])
  @@index([status])
  @@index([campaignId])
  @@map("sessions")
}

model Campaign {
  id           String    @id @default(uuid())
  name         String    @db.VarChar(150)
  slug         String    @unique @db.VarChar(150)
  description  String?   @db.Text
  logoUrl      String?   @db.VarChar(500)
  brandColor   String?   @db.VarChar(20)
  bgColor      String?   @db.VarChar(20)
  textColor    String?   @db.VarChar(20)
  cardBgColor  String?   @db.VarChar(50)
  fontFamily   String?   @db.VarChar(100)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  promptTemplates PromptTemplate[]
  jobBaseImages JobBaseImage[]

  @@map("campaigns")
}

model JobBaseImage {
  id            String    @id @default(uuid())
  job           String    @db.VarChar(100)
  gender        String    @db.VarChar(10)
  imageUrl      String    @db.VarChar(500)
  imagePath     String?   @db.VarChar(500)
  isActive      Boolean   @default(true)
  autoGenerated Boolean   @default(false)
  campaignId    String?
  campaign      Campaign? @relation(fields: [campaignId], references: [id])
  createdAt     DateTime  @default(now())

  @@index([job, gender])
  @@map("job_base_images")
}

model FaceSwapSettings {
  id        String   @id @db.VarChar(20)
  apiUrl    String?  @db.VarChar(500)
  apiKey    String?  @db.Text
  model     String?  @db.VarChar(100)
  updatedAt DateTime @updatedAt

  @@map("face_swap_settings")
}

model PromptTemplate {
  id                  String    @id @default(uuid())
  name                String    @db.VarChar(100)
  campaignId          String?
  campaign            Campaign? @relation(fields: [campaignId], references: [id])
  isDefault           Boolean   @default(false)
  promptText          String    @db.Text
  negativePrompt      String?   @db.Text
  requestBodyTemplate String?   @db.Text
  notes               String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([campaignId])
  @@map("prompt_templates")
}

model AiProvider {
  id         String    @id @default(uuid())
  name       String    @db.VarChar(100)
  apiUrl     String    @db.VarChar(500)
  apiKey     String    @db.Text
  model      String?   @db.VarChar(100)
  priority   Int       @default(0)
  isActive   Boolean   @default(true)
  failCount  Int       @default(0)
  lastFailAt DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("ai_providers")
}

model SmsProvider {
  id         String    @id @default(uuid())
  name       String    @db.VarChar(100)
  apiUrl     String    @db.VarChar(500)
  apiKey     String    @db.Text
  senderId   String?   @db.VarChar(50)
  priority   Int       @default(0)
  isActive   Boolean   @default(true)
  failCount  Int       @default(0)
  lastFailAt DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("sms_providers")
}

model AdminUser {
  id           String    @id @default(uuid())
  username     String    @unique @db.VarChar(50)
  passwordHash String    @db.VarChar(255)
  displayName  String    @db.VarChar(100)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admin_users")
}

model AdminSession {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@map("admin_sessions")
}
