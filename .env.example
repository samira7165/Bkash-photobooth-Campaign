# MySQL connection string for Prisma
DATABASE_URL="mysql://root:your_password@localhost:3306/photobooth"

# SMS Provider (plug in your provider)
SMS_API_URL=https://your-sms-provider.com/api/send
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=PHOTOBOOTH

# AI Image Generation (Google Gemini 2.0 Flash multimodal, Replicate img2img, or custom REST endpoint)
AI_API_URL=https://generativelanguage.googleapis.com
AI_API_KEY=your_gemini_or_ai_api_key

# Image retrieval frontend URL (sent in SMS)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
RETRIEVAL_URL=http://localhost:3000/gallery

# Upload directory
UPLOAD_DIR=./uploads

# Mobile QR experience + download portal
DOWNLOAD_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=5
DOWNLOAD_SESSION_SECRET=change_me_to_a_long_random_string

# XRI SMS Gateway — used for OTP delivery and the post-processing notification SMS
XRI_SMS_API_URL=https://xribd.cloud/send-otp
